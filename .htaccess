RewriteEngine On

# Remove trailing slash (optional, keeps URLs consistent)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Pretty URLs
RewriteRule ^leaderboard/?$ index.php?page=leaderboard [L,QSA]
RewriteRule ^profile/?$ index.php?page=profile [L,QSA]
RewriteRule ^profile/([a-zA-Z0-9_-]+)/?$ index.php?page=profile&user=$1 [L,QSA]

# Optional: homepage (so "/" maps to index.php)
RewriteRule ^$ index.php [L]